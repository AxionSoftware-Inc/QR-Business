# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LANGUAGE_CODE=en
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# Legacy import is disabled in the V2 runtime. Set True only during a controlled
# legacy migration rehearsal/final migration, then turn it back off.
ENABLE_LEGACY_IMPORT=False

# PostgreSQL
DB_NAME=QR
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# Shared cache/throttling. Development may leave this empty and use LocMem.
# Production with more than one backend instance should use a shared Redis URL.
REDIS_URL=
CACHE_KEY_PREFIX=qr-business-v2
CACHE_DEFAULT_TIMEOUT=300

# Frontend / CORS
PUBLIC_WEB_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Auth
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
JWT_REFRESH_COOKIE_NAME=qr_refresh
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
# JWT_REFRESH_COOKIE_DOMAIN=.example.com

# Billing adapter. Provider integration must send canonical signed events to
# /api/v2/billing/webhook/ using X-QR-Billing-Signature = HMAC-SHA256(raw body).
BILLING_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Media storage. Leave S3_BUCKET_NAME empty in development to use MEDIA_ROOT.
# Production should use a dedicated object bucket/CDN with stable public URLs.
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_CUSTOM_DOMAIN=
S3_QUERYSTRING_AUTH=False

# Privacy-safe analytics. Use a secret different from DJANGO_SECRET_KEY.
ANALYTICS_HASH_SALT=replace-with-a-separate-random-secret
# False is safe for direct app exposure. Set True only when a trusted reverse
# proxy overwrites/sanitizes X-Forwarded-For before requests reach Django.
ANALYTICS_TRUST_X_FORWARDED_FOR=False

# Optional error/performance observability. PII is disabled in application init.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_RELEASE=

# Throttling
THROTTLE_ANON=600/hour
THROTTLE_UPLOAD_MEDIA=30/hour
THROTTLE_PUBLIC_READ=1200/hour
THROTTLE_ANALYTICS_WRITE=600/hour
THROTTLE_QR_REDIRECT=1200/hour
THROTTLE_AUTH=60/hour
THROTTLE_BILLING_WEBHOOK=300/hour

# Production security overrides. The application defaults become stricter when
# DJANGO_DEBUG=False; set these deliberately for the actual reverse proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
