# Next.js / browser-visible configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_BASE_URL=http://127.0.0.1:3000

# Server-side Next.js API access
API_BASE_URL=http://127.0.0.1:8000
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Host routing. Production example: qr.example.com
ROOT_DOMAIN=localhost

# Production notes:
# - NEXT_PUBLIC_API_BASE_URL may stay empty when the browser should use the
#   same-origin Next.js /api/v2 proxy.
# - API_INTERNAL_BASE_URL should be a private backend URL when frontend and
#   backend run on the same network.
# - NEXT_PUBLIC_SITE_BASE_URL must be the canonical HTTPS platform URL used in
#   generated public links and QR assets.
# - ROOT_DOMAIN must match the platform root used for tenant subdomains.
